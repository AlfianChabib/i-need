generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  COMPANY
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkingType {
  REMOTE
  ONSITE
  HYBRID
}

enum InterviewType {
  REMOTE
  ONSITE
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InterviewStatus {
  PENDING
  ACCEPTED
  RESCHEDULED
  REJECTED
  FINISHED
  CANCELLED
}

enum JobStatus {
  ACTIVE
  CLOSED
}

model User {
  id             String          @id @default(cuid())
  username       String
  email          String          @unique
  role           Role            @default(CANDIDATE)
  profile        Profile?
  companyProfile CompanyProfile?
  auth           Auth?
  authToken      AuthToken[]
  verifyToken    VerifyToken[]
  isVerified     Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.VarChar(500)
  expiresAt DateTime
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  username    String
  phoneNumber String?
  location    String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  companyName String
  logo        String?
  address     String?
  website     String?
  industryId  Int?
  description String?
  contact     CompanyContact?
  status      CompanyStatus   @default(INACTIVE)
  industry    Industry?       @relation(fields: [industryId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  Job         Job[]
  Interview   Interview[]
}

model CompanyContact {
  id          String         @id @default(cuid())
  companyId   String         @unique
  email       String
  phoneNumber String?
  linkedin    String?
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Auth {
  id       String @id @default(cuid())
  userId   String @unique
  email    String @unique
  password String
  salt     String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthToken {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  isUsed       Boolean  @default(false)
  expiresAt    DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerifyToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String             @id @default(cuid())
  companyId      String
  title          String
  description    String             @db.VarChar()
  city           String
  redirectUrl    String?
  type           JobType
  workingType    WorkingType
  classification JobClassification?
  status         JobStatus          @default(ACTIVE)
  interviews     Interview[]
  applications   Application[]
  company        CompanyProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deleted        Boolean            @default(false)
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("jobs")
}

model Application {
  id         String            @id @default(cuid())
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     ApplicationStatus
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  interviews Interview?

  @@map("applications")
}

model Interview {
  id            String          @id @default(cuid())
  applicationId String          @unique
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        InterviewStatus
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  interviewType InterviewType
  companyId     String
  company       CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job           Job             @relation(fields: [jobId], references: [id])
  jobId         String

  @@map("interviews")
}

model JobClassification {
  id                  Int               @id @default(autoincrement())
  jobId               String            @unique
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  classification      Classification    @relation(fields: [classificationId], references: [id])
  classificationId    Int
  subClassification   SubClassification @relation(fields: [subClassificationId], references: [id])
  subClassificationId Int

  @@map("job_classifications")
}

model Classification {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar()
  subClassification SubClassification[]
  jobClassification JobClassification[]

  @@map("classifications")
}

model SubClassification {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar()
  classification    Classification      @relation(fields: [classificationId], references: [id])
  classificationId  Int
  jobCLassification JobClassification[]

  @@map("sub_classifications")
}

model Skill {
  id    Int    @id @default(autoincrement())
  title String @unique @db.VarChar(500)

  @@index([title])
  @@map("skills")
}

model Industry {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  label          String
  companyProfile CompanyProfile[]

  @@map("industries")
}
